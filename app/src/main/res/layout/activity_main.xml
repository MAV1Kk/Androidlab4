<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:id="@+id/headerBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Лабораторна робота №4"
                android:textColor="#111827"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="Відтворення аудіо, відео та цифрового радіо"
                android:textColor="#4B5563"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/modeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Тип медіа"
                android:textColor="#111827"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Оберіть, що потрібно відтворити"
                android:textColor="#4B5563"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/rgMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbAudio"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:checked="true"
                    android:buttonTint="#2563EB"
                    android:text="Аудіофайл"
                    android:textColor="#111827"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rbVideo"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:buttonTint="#2563EB"
                    android:text="Відеофайл"
                    android:textColor="#111827"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/rbRadio"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:buttonTint="#0F766E"
                    android:text="Цифрове радіо"
                    android:textColor="#111827"
                    android:textSize="16sp" />
            </RadioGroup>

            <Button
                android:id="@+id/btnPickFile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_primary"
                android:text="Обрати файл з пристрою"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/internetCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Відтворення з Інтернету"
                android:textColor="#111827"
                android:textSize="19sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etUrl"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:hint="Вставте пряме URL-посилання"
                android:inputType="textUri"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="#111827"
                android:textColorHint="#6B7280" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPlayUrl"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_primary"
                    android:text="Запустити URL"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnDownload"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_secondary"
                    android:text="Завантажити"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/radioCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HARD TASK: цифрове радіо"
                android:textColor="#111827"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Готові онлайн-станції для потокового відтворення"
                android:textColor="#4B5563"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnStation1"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_station"
                android:text="Lo-Fi радіо"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnStation2"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_station"
                android:text="Ambient радіо"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnStation3"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_station"
                android:text="Indie радіо"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/videoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:padding="10dp"
            android:visibility="gone">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:background="#000000"
                android:clickable="true"
                android:focusable="true"
                app:resize_mode="fit"
                app:show_fastforward_button="true"
                app:show_next_button="false"
                app:show_previous_button="false"
                app:show_rewind_button="true"
                app:use_controller="true" />

            <Button
                android:id="@+id/btnFullscreen"
                android:layout_width="120dp"
                android:layout_height="42dp"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:background="@drawable/bg_secondary"
                android:text="Full"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/sourceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Поточний стан"
                android:textColor="#111827"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#F3F4F6"
                android:padding="14dp"
                android:text="Медіафайл ще не вибрано"
                android:textColor="#111827"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/controlsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Керування відтворенням"
                android:textColor="#111827"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPlay"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_primary"
                    android:text="Play"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnPause"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_secondary"
                    android:text="Pause"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnStop"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_secondary"
                    android:text="Stop"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>